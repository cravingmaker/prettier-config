{
  "compilerOptions": {
    // The compiler contract of @cravingmaker/eslint-config, which lints this repository. Its
    // TypeScript rules leave unreachable code and missing returns to the compiler.
    "allowUnreachableCode": false,
    "noImplicitReturns": true,
    "strict": true,

    // Checks beyond that contract.
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,

    // Node.js 22.12, the minimum consumer runtime: ES2024 and the newer APIs that it ships.
    "lib": ["ES2024", "ES2025.Collection", "ES2025.Iterator", "ESNext.Array"],
    "module": "NodeNext",
    "target": "ES2024",
    "types": ["node"],

    // The published files are JavaScript: the compiler checks them and the tests without emitting.
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tests/fixtures"],
  "include": [
    "index.mjs",
    "index.d.ts",
    "prettier.config.mjs",
    "eslint.config.js",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "tests/**/*.ts",
    "tests/consumers/**/*.mjs"
  ]
}
