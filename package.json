{
  "name": "@cravingmaker/prettier-config",
  "version": "0.3.2",
  "private": false,
  "description": "Craving Maker's Prettier configuration",
  "keywords": [
    "cravingmaker",
    "prettier",
    "prettier-config",
    "style",
    "code-style",
    "format"
  ],
  "homepage": "https://github.com/cravingmaker/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/cravingmaker/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cravingmaker/prettier-config.git"
  },
  "funding": "https://github.com/sponsors/cravingmaker",
  "license": "MIT",
  "author": "cravingmaker (https://github.com/cravingmaker)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts"
  ],
  "scripts": {
    "deps:inspect": "node-modules-inspector --no-open",
    "deps:inspect:build": "node-modules-inspector build --outDir node_modules/.cache/node-modules-inspector-build",
    "deps:report-duplicates": "node-modules-inspector report duplicates",
    "deps:report-sizes": "node-modules-inspector report sizes",
    "effect:check": "effect-language-service diagnostics --project tsconfig.json",
    "effect:check-reference": "node scripts/check-effect-reference.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:inspect": "eslint-config-inspector --no-open",
    "lint:inspect:build": "eslint-config-inspector build --outDir node_modules/.cache/eslint-config-inspector",
    "lint:package": "publint --strict",
    "lint:staged": "lint-staged",
    "lint:unused": "knip",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run effect:check-reference && npm audit --audit-level=low && npm run validate && npm pack --dry-run --ignore-scripts",
    "setup:effect-reference": "node scripts/setup-effect-reference.mjs",
    "test": "vitest run --exclude tests/package.smoke.test.ts",
    "test:lifecycle": "vitest run tests/package-smoke-harness.test.ts",
    "test:package": "vitest run tests/package.smoke.test.ts",
    "test:package:ui": "vitest --ui --watch tests/package.smoke.test.ts",
    "test:runtime": "vitest run --exclude tests/package.smoke.test.ts --exclude tests/tooling-guards.test.ts",
    "test:tooling": "vitest run tests/tooling-guards.test.ts",
    "test:ui": "vitest --ui --watch --exclude tests/package.smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "attw --pack . --profile esm-only",
    "validate": "npm run validate:static && npm run validate:behavior",
    "validate:behavior": "npm run test:runtime && npm run test:package",
    "validate:static": "npm run effect:check-reference && npm run typecheck && npm run effect:check && npm run lint && npm run lint:unused && npm run format:check && npm run lint:workflows && npm run lint:package && npm run typecheck:package && npm run test:tooling"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,mjsx,ts,mts,tsx,mtsx,svelte,html,md,json,jsonc,json5}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --ignore-unknown --write"
    ],
    "!(*.js|*.mjs|*.cjs|*.jsx|*.mjsx|*.ts|*.mts|*.tsx|*.mtsx|*.svelte|*.html|*.md|*.json|*.jsonc|*.json5)": "prettier --ignore-unknown --write"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "micromark-extension-math@3.1.0": {
      "katex": "0.18.2"
    }
  },
  "dependencies": {
    "@prettier/plugin-oxc": "0.2.3",
    "@prettier/plugin-xml": "3.4.2",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-toml": "3.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cravingmaker/eslint-config": "0.2.0",
    "@effect/language-service": "0.87.4",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@eslint/config-inspector": "3.5.0",
    "@types/node": "22.20.5",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.5",
    "effect": "4.0.5",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "node-modules-inspector": "2.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.25",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "prettier": ">=3.9.8 <4",
    "prettier-plugin-astro": ">=0.14.1 <0.15",
    "prettier-plugin-svelte": ">=4.1.1 <5",
    "prettier-plugin-tailwindcss": ">=0.8.1 <1"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": false
    },
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-svelte": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
