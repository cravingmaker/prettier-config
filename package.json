{
  "name": "@cravingmaker/prettier-config",
  "version": "0.1.12",
  "private": false,
  "description": "Craving Maker's Prettier configuration",
  "keywords": [
    "cravingmaker",
    "prettier",
    "prettier-config",
    "style",
    "code-style",
    "format"
  ],
  "homepage": "https://github.com/cravingmaker/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/cravingmaker/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cravingmaker/prettier-config.git"
  },
  "license": "MIT",
  "author": "cravingmaker (https://github.com/cravingmaker)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check:commit": "npm run build && npm run lint:staged && npm run typecheck && npm test",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "format": "npm run build && prettier --write . && npm run build",
    "format:check": "npm run build && npm run format:check:built",
    "format:check:built": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:package": "npm run build && npm run lint:package:built",
    "lint:package:built": "publint --strict",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "npm run validate",
    "test": "vitest run --exclude tests/package.smoke.test.ts",
    "test:package": "npm run build && npm run test:package:built",
    "test:package:built": "vitest run tests/package.smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "npm run build && npm run typecheck:package:built",
    "typecheck:package:built": "attw --pack . --profile esm-only",
    "validate": "npm run build && npm run typecheck && npm run lint && npm run format:check:built && npm test && npm run test:package:built && npm run lint:package:built && npm run typecheck:package:built"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "**/*.{js,mjs,jsx,ts,mts,tsx,astro,svelte,css,html,json,jsonc,json5,md}": "eslint --fix"
  },
  "prettier": "@cravingmaker/prettier-config",
  "dependencies": {
    "@prettier/plugin-oxc": "0.2.3",
    "prettier-plugin-packagejson": "3.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cravingmaker/eslint-config": "0.0.10",
    "@cravingmaker/prettier-config": "0.1.11",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.24",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "prettier": ">=3.9.8 <4",
    "prettier-plugin-astro": ">=1.0.1 <2",
    "prettier-plugin-svelte": ">=4.1.1 <5",
    "prettier-plugin-tailwindcss": ">=0.8.1 <1"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-svelte": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
