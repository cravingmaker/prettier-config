{
  "name": "@cravingmaker/prettier-config",
  "version": "0.2.0",
  "private": false,
  "description": "Craving Maker's Prettier configuration",
  "keywords": [
    "cravingmaker",
    "prettier",
    "prettier-config",
    "style",
    "code-style",
    "format"
  ],
  "homepage": "https://github.com/cravingmaker/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/cravingmaker/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cravingmaker/prettier-config.git"
  },
  "license": "MIT",
  "author": "cravingmaker (https://github.com/cravingmaker)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts"
  ],
  "scripts": {
    "check:commit": "npm run lint:staged && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:package": "publint --strict",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "npm run validate",
    "test": "vitest run --exclude tests/package.smoke.test.ts",
    "test:package": "vitest run tests/package.smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "attw --pack . --profile esm-only",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:package && npm run lint:package && npm run typecheck:package"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,mts,tsx,astro,svelte,css,html,json,jsonc,json5,md}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.mjs|*.jsx|*.ts|*.mts|*.tsx|*.astro|*.svelte|*.css|*.html|*.json|*.jsonc|*.json5|*.md)": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@prettier/plugin-oxc": "0.2.3",
    "@prettier/plugin-xml": "3.4.2",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-toml": "3.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cravingmaker/eslint-config": "0.0.10",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.24",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "prettier": ">=3.9.8 <4",
    "prettier-plugin-astro": ">=0.14.1 <0.15",
    "prettier-plugin-svelte": ">=4.1.1 <5",
    "prettier-plugin-tailwindcss": ">=0.8.1 <1"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-svelte": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.1",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
